{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogul de fructe FruitAI",
  "description": "Sursa unică de date pentru catalog, fișele educative, scannerul AI și AR. Un fruct nou = o înregistrare nouă în „fruits”.",
  "type": "object",
  "required": [
    "categories",
    "fruits"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ro"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "ro": {
            "type": "string",
            "description": "Numele categoriei, afișat ca filtru"
          },
          "en": {
            "type": "string",
            "description": "Numele categoriei în engleză"
          }
        },
        "additionalProperties": false
      }
    },
    "fruits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fruit"
      }
    }
  },
  "$defs": {
    "fruit": {
      "type": "object",
      "required": [
        "id",
        "ro",
        "en",
        "category",
        "description",
        "fact",
        "vitamins",
        "minerals",
        "nutrition",
        "visual"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Identificator unic și stabil. Folosit în istoric, AR și maparea AI. Nu-l schimba după publicare."
        },
        "ro": {
          "type": "string",
          "description": "Denumirea în română"
        },
        "en": {
          "type": "string",
          "description": "Denumirea în engleză"
        },
        "emoji": {
          "type": "string",
          "maxLength": 16,
          "description": "Opțional: emoji-ul fructului, afișat lângă nume. Fără el se folosește ilustrația generată."
        },
        "category": {
          "type": "string",
          "description": "Trebuie să existe în „categories”"
        },
        "description": {
          "type": "string",
          "description": "Descriere educativă scurtă (1–2 propoziții)"
        },
        "descriptionEn": {
          "type": "string",
          "description": "Descrierea în engleză"
        },
        "fact": {
          "type": "string",
          "description": "O curiozitate verificabilă"
        },
        "factEn": {
          "type": "string",
          "description": "Curiozitatea în engleză"
        },
        "vitamins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vitaminele principale (poate fi gol dacă nu există date)"
        },
        "minerals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Mineralele principale (poate fi gol)"
        },
        "image": {
          "type": "string",
          "description": "Opțional: calea către o fotografie (ex. img/fruits/apple.webp). Fără ea, aplicația desenează o ilustrație din „visual”."
        },
        "showcase": {
          "type": "boolean",
          "description": "Opțional: poate apărea ca exemplu în hero și în secțiunea AR"
        },
        "nutrition": {
          "type": "object",
          "required": [
            "source",
            "per100g"
          ],
          "properties": {
            "source": {
              "type": "string",
              "description": "Intrarea USDA FoodData Central folosită"
            },
            "per100g": {
              "type": "object",
              "required": [
                "kcal",
                "protein",
                "carbs",
                "fat",
                "fiber"
              ],
              "description": "Valori per 100 g; null = indisponibil. Cheile corespund celor din nutrients.json.",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "visual": {
          "type": "object",
          "required": [
            "color",
            "shape"
          ],
          "description": "Folosit pentru ilustrația generată, eticheta 3D din AR spațial și accentele din interfață",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "shape": {
              "enum": [
                "round",
                "oval",
                "teardrop",
                "elongated",
                "cluster",
                "drupelets",
                "spiky",
                "star"
              ]
            },
            "color2": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "A doua culoare a cojii (îmbujorare, dungi, solzi)"
            },
            "texture": {
              "enum": [
                "smooth",
                "blush",
                "dimpled",
                "speckled",
                "striped",
                "fuzzy",
                "netted",
                "bloom",
                "diamond",
                "rough",
                "leathery",
                "fibrous",
                "wrinkled"
              ],
              "description": "Textura cojii, generată procedural"
            },
            "features": {
              "type": "array",
              "items": {
                "enum": [
                  "stem",
                  "leaf",
                  "calyx",
                  "crown",
                  "blossom",
                  "nubs",
                  "seeds",
                  "pair",
                  "berries",
                  "bunch",
                  "pit-bottom",
                  "scales"
                ]
              },
              "description": "Detalii 3D: codiță, frunză, caliciu, coroană, coroniță, vârfuri, semințe, pereche, bace, mână de banane"
            },
            "slice": {
              "enum": [
                "citrus",
                "greenseeds",
                "melon",
                "whiteseeds",
                "pit",
                "stone",
                "arils",
                "seedcenter",
                "pulp",
                "cream"
              ],
              "description": "Felia tăiată afișată lângă fruct"
            },
            "flesh": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Culoarea pulpei (felia)"
            },
            "aspect": {
              "type": "number",
              "description": "Alungire pe verticală (1 = normal)"
            },
            "spikes": {
              "enum": [
                "cones",
                "bumps",
                "hairs",
                "soft"
              ]
            },
            "spikeColor": {
              "type": "string"
            },
            "calyxColor": {
              "type": "string"
            },
            "rindInner": {
              "type": "string"
            },
            "seeds": {
              "enum": [
                "cavity"
              ]
            },
            "seedColor": {
              "type": "string"
            },
            "stripes": {
              "type": "integer"
            },
            "stripeWidth": {
              "type": "number"
            },
            "blush": {
              "type": "number",
              "description": "Mărimea îmbujorării (0–1)"
            },
            "leafWidth": {
              "type": "number"
            },
            "leafColor": {
              "type": "string"
            }
          }
        },
        "ai": {
          "type": "object",
          "description": "Opțional. Fără „ai”, fructul apare doar în catalog și nu poate fi recunoscut de scanner.",
          "required": [
            "labels"
          ],
          "properties": {
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Etichetele text (în engleză) date modelului CLIP. Rezultatul recunoașterii este mapat înapoi la „id” prin aceste etichete."
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
